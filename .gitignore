# Do not check IntelliJ-specific files into source control

*.iml
*.ipr
*.iws
.idea/

# Do not check Visual Studio Code-specific files into source control

*.code-workspace
.history/
dist/
diffs/

# What older versions of wsb kept under .wsb/: local state, never committed.
# Everything else under .wsb/ is wsb's committed settings and notes.
.wsb/wsb.db
.wsb/state.json
.wsb/sessions.db*
.wsb/logs/
.wsb/workbench.json

# Claude Code's settings for one checkout on one machine.
.claude/settings.local.json
